<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="mujoco_model_path" default=""/>
  <xacro:arg name="headless" default="false"/>

  <xacro:include filename="$(find description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>
  <xacro:include filename="$(find description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find mujoco)/urdf/mujoco_ros2_control.xacro"/>

  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="joint_limit_params" default="$(find description)/config/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find description)/config/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find description)/config/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find description)/config/visual_parameters.yaml"/>

  <link name="world" />

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="true"
    safety_pos_margin="0.15"
    safety_k_position="20"
    use_fake_hardware="false"
    generate_ros2_control_tag="false"
    headless_mode="false"
    initial_positions="${dict(shoulder_pan_joint=0.0,shoulder_lift_joint=-1.57,elbow_joint=0.0,wrist_1_joint=-1.57,wrist_2_joint=0.0,wrist_3_joint=0.0)}"
    robot_ip="0.0.0.0"
    >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <xacro:ur_to_robotiq prefix="" parent="$(arg tf_prefix)tool0" child="robotiq_adapter_link"/>
  <xacro:robotiq_gripper
    name="RobotiqGripperHardwareInterface"
    prefix=""
    parent="robotiq_adapter_link"
    use_fake_hardware="false"
    include_ros2_control="false"
    gripper_closed_position="0.0"
    >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:robotiq_gripper>

  <xacro:mujoco_ros2_control
    mujoco_model_path="$(arg mujoco_model_path)"
    headless="$(arg headless)"/>

</robot>
